---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RfqForm from '../components/RfqForm.astro';
import Icon from '../components/Icon.astro';
import { CONTACT } from '../config';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const c = {
  en: {
    metaTitle: 'Contact & Request a Quote',
    metaDesc:
      'Contact Al Majeed Plastic Industries in North Marka, Amman — phone, e-mail and a form to request a quote or samples for PET and HDPE packaging.',
    eyebrow: 'Contact',
    title: 'Talk to the factory',
    lede: 'Quotes, samples, a new mould or a technical question — the sales team answers from the plant in North Marka.',
    phone: 'Phone',
    email: 'E-mail',
    address: 'Factory address',
    hours: 'Working hours',
    hoursText: CONTACT.hoursEn,
    formEyebrow: 'Quote or samples',
    formTitle: 'Tell us what you are filling',
    formLede: 'The more we know about your product and filling line, the more precise our offer.',
    mapTitle: 'Al Majeed Plastic Industries location map',
  },
  ar: {
    metaTitle: 'تواصل معنا واطلب عرض سعر',
    metaDesc: 'تواصل مع المجيد للصناعات البلاستيكية في ماركا الشمالية، عمّان — هاتف وبريد ونموذج لطلب عرض سعر أو عيّنات لعبوات PET و HDPE.',
    eyebrow: 'تواصل معنا',
    title: 'احكي مع المصنع مباشرة',
    lede: 'عرض سعر، عيّنات، قالب جديد أو سؤال فني — فريق المبيعات بيرد عليك من المصنع في ماركا الشمالية.',
    phone: 'الهاتف',
    email: 'البريد الإلكتروني',
    address: 'عنوان المصنع',
    hours: 'ساعات العمل',
    hoursText: CONTACT.hoursAr,
    formEyebrow: 'عرض سعر أو عيّنات',
    formTitle: 'احكيلنا شو بدك تعبّي',
    formLede: 'كل ما عرفنا أكثر عن منتجك وخط التعبئة عندك، كان عرضنا أدق.',
    mapTitle: 'خريطة موقع المجيد للصناعات البلاستيكية',
  },
}[lang];

const card = 'rounded-2xl border border-line bg-white p-6 shadow-sm';
const iconBox = 'inline-flex h-10 w-10 items-center justify-center rounded-lg bg-aqua-light text-aqua-dark';
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDesc}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lede={c.lede} />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_1.5fr]">
      <div class="space-y-4">
        <div class={card}>
          <div class="flex items-center gap-3">
            <span class={iconBox}><Icon name="phone" class="h-5 w-5" /></span>
            <h2 class="text-base font-bold text-navy">{c.phone}</h2>
          </div>
          <p class="mt-3 text-sm">
            <a href={`tel:${CONTACT.phoneHref}`} class="text-lg font-bold text-navy hover:text-aqua-dark" dir="ltr">{CONTACT.phone}</a>
          </p>
          <p class="mt-1 text-sm">
            <a href={`tel:${CONTACT.phone2Href}`} class="font-semibold text-navy/80 hover:text-aqua-dark" dir="ltr">{CONTACT.phone2}</a>
          </p>
        </div>

        <div class={card}>
          <div class="flex items-center gap-3">
            <span class={iconBox}><Icon name="mail" class="h-5 w-5" /></span>
            <h2 class="text-base font-bold text-navy">{c.email}</h2>
          </div>
          <p class="mt-3 text-sm">
            <a href={`mailto:${CONTACT.emailHref}`} class="break-all font-semibold text-navy hover:text-aqua-dark">{CONTACT.email}</a>
          </p>
          <p class="mt-1 text-sm">
            <a href={`mailto:${CONTACT.emailInfo}`} class="break-all text-navy/80 hover:text-aqua-dark">{CONTACT.emailInfo}</a>
          </p>
        </div>

        <div class={card}>
          <div class="flex items-center gap-3">
            <span class={iconBox}><Icon name="map-pin" class="h-5 w-5" /></span>
            <h2 class="text-base font-bold text-navy">{c.address}</h2>
          </div>
          <p class="mt-3 text-sm text-ink/80">{lang === 'ar' ? CONTACT.addressAr : CONTACT.addressEn}</p>
          <div class="mt-4 flex items-center gap-3 border-t border-line pt-4">
            <span class={iconBox}><Icon name="clock" class="h-5 w-5" /></span>
            <div>
              <p class="text-sm font-bold text-navy">{c.hours}</p>
              <p class="text-sm text-ink/70">{c.hoursText}</p>
            </div>
          </div>
        </div>
      </div>

      <div id="rfq" class="scroll-mt-28 rounded-2xl border border-line bg-mist p-6 sm:p-8">
        <SectionHeading eyebrow={c.formEyebrow} title={c.formTitle} lede={c.formLede} align="start" class="mb-8" />
        <RfqForm lang={lang} />
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <iframe
      src={CONTACT.mapEmbedUrl}
      title={c.mapTitle}
      class="block h-[380px] w-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </section>
</BaseLayout>
