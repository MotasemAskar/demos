---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { PRODUCTS, sectorName } from '../data/products';
import { type Lang, localePath } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (p: string) => localePath(lang, p);

const c = {
  en: {
    metaTitle: 'Products — PET Preforms, Bottles, Gallons & Jars',
    metaDesc:
      'PET preforms, detergent and cosmetic bottles, food and dairy containers, oil and chemical gallons, jars and medical containers — made by Al Majeed Plastic Industries in Amman.',
    eyebrow: 'Products',
    title: 'Containers for every filling line',
    lede: 'Six product families, two processes and one standard: a container that fills, seals and ships the same way every time.',
    jump: 'Jump to',
    includes: 'Includes',
    uses: 'Used by',
    quote: 'Request a quote',
    sample: 'Request samples',
    customEyebrow: 'Don’t see your shape?',
    customTitle: 'Bring us a sketch — we will build the mould',
    customLede:
      'A new product launch, a lighter bottle or a container that looks like nobody else’s on the shelf. Our mould shop turns your idea into a production mould, then our lines run it.',
    customSteps: [
      { icon: 'message-square', title: 'Your idea', text: 'A sketch, a sample bottle or a reference' },
      { icon: 'cog', title: 'Mould design', text: 'Designed for your volume and machine' },
      { icon: 'check', title: 'Trial samples', text: 'You approve the first pieces' },
      { icon: 'package', title: 'Production', text: 'Same mould, every repeat order' },
    ],
    customLink: 'About our mould making',
    customAlt: 'Clear plastic bottle prototypes next to a steel mould',
    note: 'Sizes, weights and neck finishes are confirmed with each order — tell us what your filling line runs and we will match it.',
  },
  ar: {
    metaTitle: 'المنتجات — بريفورم PET وقوارير وجالونات وبرطمانات',
    metaDesc:
      'بريفورم PET، عبوات المنظفات والتجميل، عبوات الأغذية والألبان، جالونات الزيوت والكيماويات، البرطمانات والعبوات الطبية — من المجيد للصناعات البلاستيكية في عمّان.',
    eyebrow: 'المنتجات',
    title: 'عبوات لكل خط تعبئة',
    lede: 'ست عائلات منتجات، طريقتين تصنيع، ومعيار واحد: عبوة بتتعبّى وبتتسكّر وبتنشحن بنفس الطريقة كل مرة.',
    jump: 'انتقل إلى',
    includes: 'تشمل',
    uses: 'يستخدمها',
    quote: 'اطلب عرض سعر',
    sample: 'اطلب عيّنات',
    customEyebrow: 'شكلك مش موجود؟',
    customTitle: 'جيب لنا رسمة — ونحن نصنع القالب',
    customLede:
      'منتج جديد، أو عبوة أخف، أو عبوة ما بتشبه أي عبوة ثانية على الرف. قسم القوالب عنا بحوّل فكرتك لقالب إنتاج، وخطوطنا بتشغّله.',
    customSteps: [
      { icon: 'message-square', title: 'فكرتك', text: 'رسمة أو عبوة عيّنة أو مرجع' },
      { icon: 'cog', title: 'تصميم القالب', text: 'حسب الحجم والماكينة' },
      { icon: 'check', title: 'عيّنات التجربة', text: 'بتعتمد أول القطع' },
      { icon: 'package', title: 'الإنتاج', text: 'نفس القالب بكل طلب متكرر' },
    ],
    customLink: 'عن تصنيع القوالب',
    customAlt: 'نماذج قوارير بلاستيكية شفافة بجانب قالب معدني',
    note: 'المقاسات والأوزان ونوع العنق تُحدَّد مع كل طلب — احكيلنا شو بيشغّل خط التعبئة عندك ونطابقه.',
  },
}[lang];
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDesc}>
  <PageHero eyebrow={c.eyebrow} title={c.title} lede={c.lede} image="/images/products/hero-range.webp" />

  <nav class="sticky top-[68px] z-40 border-b border-line bg-white/95 backdrop-blur lg:top-[84px]" aria-label={c.jump}>
    <ul class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 sm:px-6 lg:px-8">
      {
        PRODUCTS.map((p) => (
          <li class="shrink-0">
            <a href={`#${p.slug}`} class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3.5 py-1.5 text-sm font-semibold text-navy transition hover:border-aqua hover:bg-aqua-light">
              <Icon name={p.icon} class="h-4 w-4 text-aqua-dark" />
              {p.name[lang]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {
      PRODUCTS.map((p, i) => (
        <section id={p.slug} class="scroll-mt-40 border-b border-line py-16 last:border-b-0 lg:py-20">
          <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:gap-14">
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <img src={p.image} alt={p.imageAlt[lang]} width="960" height="600" loading="lazy" class="aspect-[16/10] w-full rounded-2xl object-cover shadow-md" />
            </div>
            <div>
              <div class="flex items-center gap-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-aqua-light text-aqua-dark">
                  <Icon name={p.icon} class="h-6 w-6" />
                </span>
                <h2 class="font-display text-2xl font-extrabold tracking-tight text-navy sm:text-3xl">{p.name[lang]}</h2>
              </div>
              <p class="mt-5 text-base leading-relaxed text-ink/75">{p.desc[lang]}</p>

              <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-ink/50">{c.includes}</p>
              <ul class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
                {p.items.map((it) => (
                  <li class="flex items-start gap-2 text-sm text-ink/80">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-aqua-dark" />
                    {it[lang]}
                  </li>
                ))}
              </ul>

              <dl class="mt-6 divide-y divide-line overflow-hidden rounded-xl border border-line">
                {p.specs.map((s) => (
                  <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-3 bg-white px-4 py-3 text-sm odd:bg-mist">
                    <dt class="font-semibold text-navy">{s.k[lang]}</dt>
                    <dd class="text-ink/75">{s.v[lang]}</dd>
                  </div>
                ))}
              </dl>

              <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-ink/50">{c.uses}</p>
              <ul class="mt-2 flex flex-wrap gap-2">
                {p.sectors.map((a) => (
                  <li class="rounded-full bg-aqua-light px-3 py-1 text-xs font-semibold text-aqua-dark">{sectorName(a, lang)}</li>
                ))}
              </ul>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a href={L(`/contact?product=${p.slug}#rfq`)} class="inline-flex items-center justify-center gap-2 rounded-md bg-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-deep">
                  {c.quote}
                  <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
                </a>
                <a href={L(`/contact?product=${p.slug}&type=sample#rfq`)} class="inline-flex items-center justify-center gap-2 rounded-md border border-navy/20 px-5 py-2.5 text-sm font-semibold text-navy transition hover:border-aqua hover:bg-aqua-light">
                  {c.sample}
                </a>
              </div>
            </div>
          </div>
        </section>
      ))
    }
    <p class="pb-12 text-sm text-ink/55">{c.note}</p>
  </div>

  <section class="bg-navy-deep">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.3fr_1fr] lg:px-8">
      <div>
        <SectionHeading eyebrow={c.customEyebrow} title={c.customTitle} lede={c.customLede} align="start" tone="light" />
        <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            c.customSteps.map((s, i) => (
              <li class="flex items-start gap-4 rounded-xl bg-white/5 p-4 ring-1 ring-white/10">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-aqua text-navy-deep">
                  <Icon name={s.icon} class="h-5 w-5" />
                </span>
                <span>
                  <span class="block text-sm font-bold text-white">
                    <span dir="ltr">{i + 1}.</span> {s.title}
                  </span>
                  <span class="mt-0.5 block text-sm text-white/65">{s.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <a href={L('/moulds')} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-aqua hover:underline">
          {c.customLink}
          <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
        </a>
      </div>
      <img src="/images/factory/prototypes.webp" alt={c.customAlt} width="900" height="1200" loading="lazy" class="mx-auto aspect-[3/4] w-full max-w-sm rounded-2xl object-cover shadow-xl" />
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
