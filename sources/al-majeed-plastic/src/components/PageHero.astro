---
import BottlePattern from './BottlePattern.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: string;
}
const { eyebrow, title, lede, image } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy">
  {image && <img src={image} alt="" width="1920" height="1080" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25" />}
  <BottlePattern class="absolute inset-0 -z-10 h-full w-full" opacity={0.07} />
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-teal/60 via-navy/70 to-navy" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-aqua">{eyebrow}</p>}
    <h1 class="font-display max-w-3xl text-3xl font-extrabold tracking-tight text-white sm:text-5xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">{lede}</p>}
  </div>
  <div class="color-rule" aria-hidden="true"></div>
</section>
