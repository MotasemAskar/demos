---
/**
 * Decorative line-art of preforms, bottles and gallons — the plant's product family.
 * Purely presentational — hidden from assistive tech.
 */
interface Props {
  class?: string;
  opacity?: number;
}
const { class: className = '', opacity = 0.14 } = Astro.props;
const id = `bottles-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} aria-hidden="true" role="presentation">
  <defs>
    <pattern id={id} x="0" y="0" width="132" height="120" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#9adbe5" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity={opacity}>
        <!-- preform -->
        <path d="M14 14h10M15 18h8M16 18v26a3 3 0 0 0 6 0V18" />
        <!-- bottle -->
        <path d="M52 10h8v6c0 3 6 5 6 12v30a4 4 0 0 1-4 4H50a4 4 0 0 1-4-4V28c0-7 6-9 6-12z" />
        <path d="M46 36h20" />
        <!-- gallon -->
        <path d="M92 70h20a6 6 0 0 1 6 6v32a4 4 0 0 1-4 4H90a4 4 0 0 1-4-4V80l6-10z M100 64h8v6h-8z M104 82h8v10h-8" />
        <!-- jar -->
        <path d="M20 80h22v6H20zM18 86h26v24a3 3 0 0 1-3 3H21a3 3 0 0 1-3-3z" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
