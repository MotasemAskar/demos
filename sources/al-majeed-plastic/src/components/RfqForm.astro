---
import { PRODUCTS, SECTORS } from '../data/products';
import { CONTACT } from '../config';
import Icon from './Icon.astro';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const t = {
  en: {
    type: 'I need', quote: 'A price quote', sample: 'Samples',
    name: 'Your name', company: 'Company / brand', phone: 'Phone / WhatsApp', email: 'E-mail',
    product: 'Container type', choose: 'Select a product…', mould: 'A new mould for my own shape', other: 'Other / not sure',
    app: 'What goes inside', chooseApp: 'Select your sector…',
    color: 'Volume / size', colorPh: 'e.g. 1 L, 500 ml, 4 L gallon, 28 mm neck',
    polymer: 'Material', polymerPh: 'PET, HDPE — or leave it to us',
    qty: 'Monthly quantity (pieces)', city: 'City / country', cityPh: 'e.g. Amman, Riyadh, Baghdad, Doha',
    message: 'Message', messagePh: 'Shape, colour, cap type, the bottle you use today, timing…',
    send: 'Send request', wa: 'Send via WhatsApp',
    notConfigured: 'Demo: in the live site this request goes straight to sales@al-majeed.com.',
    sending: 'Sending…', ok: 'Thank you — your request has been sent. We will reply shortly.',
    fail: 'Something went wrong. Please try again or call us.',
    net: 'Network error. Please try again or call us.',
    summary: 'Request', kg: 'pcs',
  },
  ar: {
    type: 'أحتاج', quote: 'عرض سعر', sample: 'عيّنات',
    name: 'الاسم', company: 'الشركة / العلامة التجارية', phone: 'الهاتف / واتساب', email: 'البريد الإلكتروني',
    product: 'نوع العبوة', choose: 'اختر المنتج…', mould: 'قالب جديد لشكل خاص فيني', other: 'أخرى / غير متأكد',
    app: 'شو رح تعبّي فيها', chooseApp: 'اختر القطاع…',
    color: 'الحجم / المقاس', colorPh: 'مثال: 1 لتر، 500 مل، جالون 4 لتر، عنق 28 مم',
    polymer: 'المادة', polymerPh: 'PET أو HDPE — أو اتركها علينا',
    qty: 'الكمية الشهرية (قطعة)', city: 'المدينة / الدولة', cityPh: 'مثال: عمّان، الرياض، بغداد، الدوحة',
    message: 'رسالتك', messagePh: 'الشكل، اللون، نوع الغطاء، العبوة اللي بتستخدمها حالياً، الموعد…',
    send: 'أرسل الطلب', wa: 'أرسل عبر واتساب',
    notConfigured: 'نسخة تجريبية: بالموقع الفعلي بيوصل الطلب مباشرة على sales@al-majeed.com.',
    sending: 'جارٍ الإرسال…', ok: 'شكراً لك — تم إرسال طلبك وسنرد عليك قريباً.',
    fail: 'حدث خطأ. حاول مرة أخرى أو اتصل بنا.',
    net: 'خطأ في الاتصال. حاول مرة أخرى أو اتصل بنا.',
    summary: 'طلب', kg: 'قطعة',
  },
}[lang];

const inputClass =
  'w-full rounded-md border border-ink/20 bg-white px-3 py-2.5 text-sm text-ink placeholder:text-ink/40 focus:border-aqua-dark focus:outline-none focus:ring-2 focus:ring-aqua/40';
const labelClass = 'mb-1.5 block text-sm font-semibold text-navy';
---

<form id="rfq-form" class="space-y-5" method="post">
  <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute; inline-size:1px; block-size:1px; opacity:0; pointer-events:none;" />

  <fieldset>
    <legend class={labelClass}>{t.type}</legend>
    <div class="grid grid-cols-2 gap-3">
      <label class="flex cursor-pointer items-center gap-2 rounded-md border border-ink/20 px-3 py-2.5 text-sm font-semibold text-navy has-[:checked]:border-aqua-dark has-[:checked]:bg-aqua-light">
        <input type="radio" name="request_type" value="quote" checked class="accent-[#0b6c7a]" /> {t.quote}
      </label>
      <label class="flex cursor-pointer items-center gap-2 rounded-md border border-ink/20 px-3 py-2.5 text-sm font-semibold text-navy has-[:checked]:border-aqua-dark has-[:checked]:bg-aqua-light">
        <input type="radio" name="request_type" value="sample" class="accent-[#0b6c7a]" /> {t.sample}
      </label>
    </div>
  </fieldset>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label for="rfq-name" class={labelClass}>{t.name} <span class="text-aqua-dark">*</span></label>
      <input id="rfq-name" name="name" type="text" required autocomplete="name" class={inputClass} />
    </div>
    <div>
      <label for="rfq-company" class={labelClass}>{t.company}</label>
      <input id="rfq-company" name="company" type="text" autocomplete="organization" class={inputClass} />
    </div>
    <div>
      <label for="rfq-phone" class={labelClass}>{t.phone} <span class="text-aqua-dark">*</span></label>
      <input id="rfq-phone" name="phone" type="tel" required autocomplete="tel" dir="ltr" placeholder="+962 …" class={inputClass} />
    </div>
    <div>
      <label for="rfq-email" class={labelClass}>{t.email}</label>
      <input id="rfq-email" name="email" type="email" autocomplete="email" dir="ltr" class={inputClass} />
    </div>
    <div>
      <label for="rfq-product" class={labelClass}>{t.product} <span class="text-aqua-dark">*</span></label>
      <select id="rfq-product" name="product" required class={inputClass}>
        <option value="" disabled selected>{t.choose}</option>
        {PRODUCTS.map((p) => <option value={p.slug}>{p.name[lang]}</option>)}
        <option value="mould">{t.mould}</option>
        <option value="other">{t.other}</option>
      </select>
    </div>
    <div>
      <label for="rfq-app" class={labelClass}>{t.app}</label>
      <select id="rfq-app" name="application" class={inputClass}>
        <option value="" selected>{t.chooseApp}</option>
        {SECTORS.map((a) => <option value={a.slug}>{a.name[lang]}</option>)}
      </select>
    </div>
    <div>
      <label for="rfq-color" class={labelClass}>{t.color}</label>
      <input id="rfq-color" name="volume" type="text" placeholder={t.colorPh} class={inputClass} />
    </div>
    <div>
      <label for="rfq-polymer" class={labelClass}>{t.polymer}</label>
      <input id="rfq-polymer" name="material" type="text" placeholder={t.polymerPh} class={inputClass} />
    </div>
    <div>
      <label for="rfq-qty" class={labelClass}>{t.qty} <span class="text-aqua-dark">*</span></label>
      <input id="rfq-qty" name="quantity_pcs" type="number" min="1" step="1" required dir="ltr" class={inputClass} />
    </div>
    <div>
      <label for="rfq-city" class={labelClass}>{t.city} <span class="text-aqua-dark">*</span></label>
      <input id="rfq-city" name="city_country" type="text" required placeholder={t.cityPh} class={inputClass} />
    </div>
  </div>

  <div>
    <label for="rfq-message" class={labelClass}>{t.message}</label>
    <textarea id="rfq-message" name="message" rows="4" placeholder={t.messagePh} class={inputClass}></textarea>
  </div>

  <p id="rfq-status" role="status" aria-live="polite" class="min-h-6 text-sm font-medium"></p>

  <div class="flex flex-col gap-3 sm:flex-row">
    <button type="submit" id="rfq-submit" class="inline-flex flex-1 items-center justify-center gap-2 rounded-md bg-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-navy-deep disabled:cursor-not-allowed disabled:opacity-60">
      <Icon name="mail" class="h-4 w-4" />
      {t.send}
    </button>
    {CONTACT.whatsappNumber && <button type="button" id="rfq-whatsapp" class="inline-flex flex-1 items-center justify-center gap-2 rounded-md bg-[#128c4a] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#0e6e3a]">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.273.297-1.04 1.016-1.04 2.479 0 1.462 1.064 2.875 1.213 3.074.148.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.57-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
      {t.wa}
    </button>}
  </div>
</form>

<script define:vars={{ KEY: WEB3FORMS_KEY, WA_NUMBER: CONTACT.whatsappNumber, T: t }}>
  const form = document.getElementById('rfq-form');
  const statusEl = document.getElementById('rfq-status');
  const submitBtn = document.getElementById('rfq-submit');
  const waBtn = document.getElementById('rfq-whatsapp');
  const productSelect = document.getElementById('rfq-product');

  // Preselect from ?product=<slug>&type=sample (used by product-page links)
  const params = new URLSearchParams(window.location.search);
  const requested = params.get('product');
  if (requested && productSelect && [...productSelect.options].some((o) => o.value === requested)) {
    productSelect.value = requested;
  }
  if (params.get('type') === 'sample') {
    const r = form.querySelector('input[name="request_type"][value="sample"]');
    if (r) r.checked = true;
  }

  const val = (name) => {
    const el = form.elements[name];
    return el && el.value ? String(el.value).trim() : '';
  };
  const optLabel = (id) => {
    const s = document.getElementById(id);
    return s && s.value ? s.options[s.selectedIndex].textContent.trim() : '';
  };
  const typeLabel = () => (val('request_type') === 'sample' ? T.sample : T.quote);

  const buildSummary = () =>
    [
      T.summary + ' — Al Majeed (' + typeLabel() + ')',
      T.name + ': ' + val('name'),
      val('company') ? T.company + ': ' + val('company') : '',
      T.phone + ': ' + val('phone'),
      val('email') ? T.email + ': ' + val('email') : '',
      T.product + ': ' + optLabel('rfq-product'),
      val('application') ? T.app + ': ' + optLabel('rfq-app') : '',
      val('volume') ? T.color + ': ' + val('volume') : '',
      val('material') ? T.polymer + ': ' + val('material') : '',
      T.qty + ': ' + val('quantity_pcs') + ' ' + T.kg,
      T.city + ': ' + val('city_country'),
      val('message') ? T.message + ': ' + val('message') : '',
    ]
      .filter(Boolean)
      .join('\n');

  const setStatus = (msg, ok) => {
    statusEl.textContent = msg;
    statusEl.className = 'min-h-6 text-sm font-medium ' + (ok ? 'text-[#0e6e3a]' : 'text-[#b42318]');
  };

  waBtn?.addEventListener('click', () => {
    if (!form.reportValidity()) return;
    window.open('https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(buildSummary()), '_blank', 'noopener');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    if (!KEY || KEY === 'REPLACE_WITH_YOUR_WEB3FORMS_KEY') {
      setStatus(T.notConfigured, false);
      return;
    }
    submitBtn.disabled = true;
    setStatus(T.sending, true);
    try {
      const data = Object.fromEntries(new FormData(form));
      delete data.botcheck;
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: KEY,
          subject: 'New ' + data.request_type + ' request — ' + (optLabel('rfq-product') || 'general'),
          from_name: 'Al Majeed website',
          ...data,
        }),
      });
      const json = await res.json();
      if (json.success) {
        form.reset();
        setStatus(T.ok, true);
      } else {
        setStatus(T.fail, false);
      }
    } catch {
      setStatus(T.net, false);
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
